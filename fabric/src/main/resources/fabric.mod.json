{
  "schemaVersion": 1,
  "id": "$project.mod.id",
  "version": "$version",

  "name": "$project.root.name",
  "description": "$project.description",
  "authors": [
    "$project.author"
  ],
  "contact": {
    "sources": "https://github.com/Communi-Suggestu/Scena"
  },

  "license": "$project.license",
  "icon": "logo.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.communi.suggestu.scena.fabric.Fabric"
    ]
  },
  "mixins": [
    "scena.mixins.json"
  ],
  "accessWidener" : "scena.accesswidener",
  "depends": {
    "fabricloader": "${dependencies.net.fabricmc.fabric.loader.npm}",
    "fabric": ">${dependencies.fabric.api.npm.get()}",
    "minecraft": [${minecraft.range.fabric.get()}],
    "java": ">=${java.version.get()}",
    "saeculariacaudices": "$dependencies.com.communi_suggestu.saecularia_caudices.fabric.npm"
  },
  "suggests": {
  },

  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_773": [
        "com/communi/suggestu/scena/fabric/platform/client/rendering/model/IModelBakeryAccessor"
      ]
    }
  }
}
